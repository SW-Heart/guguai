[Unit]
Description=GuGu AI database backup (local snapshot + off-site copy)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gugu
Group=gugu
WorkingDirectory=/opt/gugu-ai
ExecStart=/usr/bin/node --env-file=.env scripts/db-backup.mjs --upload
TimeoutStartSec=900
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gugu-ai
